        <mxCell id="listeners" value="&lt;b&gt;SK Listeners — SkCommandIn ×2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2a78d6&quot; style=&quot;font-size:11.5px&quot;&gt;tx.port / tx.stbd / tx.enabled&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8250df&quot; style=&quot;font-size:11.5px&quot;&gt;plugin.port / plugin.stbd / plugin.enabled&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
