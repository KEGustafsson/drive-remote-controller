<mxfile host="app.diagrams.net">
  <diagram id="rx-architecture" name="RX architecture">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#fcfcfb" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="zone_periphery" value="" style="rounded=1;arcSize=6;html=1;fillColor=#eaf2fb;strokeColor=#c3c2b7;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="50" width="1160" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="zone_core" value="" style="rounded=1;arcSize=6;html=1;fillColor=#eef6ec;strokeColor=#c3c2b7;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="314" width="1160" height="330" as="geometry"/>
        </mxCell>

        <mxCell id="title" value="RX — Motion Controller Architecture" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=19;fontStyle=1;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="300" y="16" width="600" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="lbl_periphery" value="SMART PERIPHERY — SensESP / Arduino loop task · may jitter freely, never touches the servos" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13.5;fontStyle=1;fontColor=#184f95;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="900" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lbl_core" value="SAFE CORE — FreeRTOS control task · core 1 · fixed 20 ms tick · TWDT-watched · owns the servos and the engage relay" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=13.5;fontStyle=1;fontColor=#1a7f37;" vertex="1" parent="1">
          <mxGeometry x="40" y="326" width="1000" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="wifi" value="&lt;b&gt;WiFi + Signal K&lt;br&gt;Client&lt;/b&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
