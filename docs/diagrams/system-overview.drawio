<mxfile host="app.diagrams.net">
  <diagram id="system-overview" name="System overview">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#fcfcfb" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Drive Remote Controller — System Overview" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=19;fontStyle=1;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="260" y="20" width="600" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Three remote stations, two independent machines, one arm token" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12.5;fontColor=#57534e;" vertex="1" parent="1">
          <mxGeometry x="260" y="46" width="600" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="tx" value="&lt;b style=&quot;font-size:14.5px&quot;&gt;TX — Handheld Controller&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11.5px&quot;&gt;9 V handheld · port + stbd shift&lt;br&gt;thruster port/stbd + MANUAL/HOLD&lt;br&gt;enable/kill switch · status LED&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#2a78d6&quot; style=&quot;font-size:11px&quot;&gt;outranks the plugin, always&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=14.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="222" height="112" as="geometry"/>
        </mxCell>

        <mxCell id="ui" value="&lt;b style=&quot;font-size:14.5px&quot;&gt;Plugin Web UI ×N&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11.5px&quot;&gt;phone / tablet · React 19 touch&lt;br&gt;drives · thruster · heading trim&lt;br&gt;kill switch · traffic-light status&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8250df&quot; style=&quot;font-size:11px&quot;&gt;stream is READ-ONLY — writes nothing&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#8250df;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=14.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="40" y="424" width="222" height="112" as="geometry"/>
        </mxCell>

        <mxCell id="android" value="&lt;b style=&quot;font-size:14.5px&quot;&gt;Android App — native station&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11.5px&quot;&gt;phone · Compose · pure core shared&lt;br&gt;with the firmware, ported to Kotlin&lt;br&gt;access-request token · refuses cleartext&lt;br&gt;off a private network&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8250df&quot; style=&quot;font-size:11px&quot;&gt;same intent route, 250 ms heartbeat&lt;br&gt;stream is READ-ONLY — writes nothing&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#8250df;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=14.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="222" height="142" as="geometry"/>
        </mxCell>

        <mxCell id="sk" value="&lt;b style=&quot;font-size:14.5px&quot;&gt;Signal K Server&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11.5px&quot;&gt;boat WiFi network&lt;br&gt;existing infrastructure&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6e7781;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=14.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="392" y="212" width="200" height="84" as="geometry"/>
        </mxCell>

        <mxCell id="arbiter" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Plugin Server — arbiter&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;runs inside the SK server&lt;br&gt;sole writer of plugin.*&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;exclusive arm · universal disarm&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8250df&quot; style=&quot;font-size:10.5px&quot;&gt;arms only while a unit answers&lt;br&gt;one arm covers both machines&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#8250df;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="392" y="392" width="200" height="118" as="geometry"/>
        </mxCell>

        <mxCell id="rxlocal" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;RX Local Switches&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;hardwired — no WiFi needed&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="742" y="76" width="238" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="rx" value="&lt;b style=&quot;font-size:14.5px&quot;&gt;RX — Motion Controller&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11.5px&quot;&gt;arbitrates every source, fails to NEUTRAL,&lt;br&gt;arms only with both levers neutral,&lt;br&gt;drives two shift servos + engage relay&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=3;fontFamily=Segoe UI;fontSize=14.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="742" y="176" width="238" height="98" as="geometry"/>
        </mxCell>

        <mxCell id="portdrive" value="&lt;b&gt;Port Drive&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10px&quot;&gt;fwd / neutral / rev&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=12.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="742" y="318" width="112" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="stbddrive" value="&lt;b&gt;Stbd Drive&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10px&quot;&gt;fwd / neutral / rev&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=12.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="868" y="318" width="112" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="hhlocal" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;HH Local ENGAGE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;hardwired — always means HOLD&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="742" y="432" width="238" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="hh" value="&lt;b style=&quot;font-size:14.5px&quot;&gt;HH — Heading Hold&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11.5px&quot;&gt;IMU @ 100 Hz · safety FSM&lt;br&gt;MANUAL gate or hold control law&lt;br&gt;fails OFF, independent watchdog&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;GNSS true heading in via Signal K&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=3;fontFamily=Segoe UI;fontSize=14.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="742" y="532" width="238" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="thruster" value="&lt;b&gt;Bow Thruster&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10px&quot;&gt;ENABLE · PORT · STBD&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=12.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="784" y="686" width="154" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="ruleblock" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;One rule, both machines&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;&lt;b&gt;&lt;font color=&quot;#1a7f37&quot;&gt;Local&lt;/font&gt;&lt;/b&gt; &amp;gt; &lt;b&gt;&lt;font color=&quot;#2a78d6&quot;&gt;TX&lt;/font&gt;&lt;/b&gt; &amp;gt; &lt;b&gt;&lt;font color=&quot;#8250df&quot;&gt;Plugin&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;Fixed precedence, never recency.&lt;br&gt;&lt;br&gt;Local is unconditional and needs no link. A&lt;br&gt;remote source commands only while it is live&lt;br&gt;(updated &amp;lt; 1 s ago) and reports itself enabled.&lt;br&gt;&lt;br&gt;Nothing qualifying gives the safe value: NEUTRAL&lt;br&gt;for a drive, OFF for the thruster — never the last&lt;br&gt;command received.&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;font color=&quot;#8250df&quot; style=&quot;font-size:11px&quot;&gt;Three stations, three tiers — not four. The web UI&lt;br&gt;and the Android app are both CLIENTS of the one&lt;br&gt;arbiter, which holds the arm token and is the sole&lt;br&gt;writer of plugin.*. A new station adds no authority.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingTop=6;fillColor=#ffffff;strokeColor=#898781;strokeWidth=1.5;dashed=1;dashPattern=5 4;fontFamily=Segoe UI;fontSize=12.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="40" y="736" width="340" height="296" as="geometry"/>
        </mxCell>

