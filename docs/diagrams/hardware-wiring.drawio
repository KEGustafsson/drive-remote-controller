        <mxCell id="rx_esp" value="&lt;b style=&quot;font-size:14px&quot;&gt;SH-ESP32&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:12px&quot;&gt;RX unit&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;b style=&quot;font-size:11.5px&quot;&gt;Onboard LED — GPIO2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10px&quot;&gt;off = no link · fast blink =&lt;br&gt;arm refused · slow = ready&lt;br&gt;solid = a remote is in command&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:10px&quot;&gt;shift commons -&amp;gt; onboard 3V3&lt;br&gt;shift GPIOs: INPUT_PULLDOWN&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;GPIO36/39: plain INPUT —&lt;br&gt;no internal pull exists&lt;/font&gt;&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;b style=&quot;font-size:11px&quot;&gt;VIN / GND terminal&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=8;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=14;fontColor=#1c1917;" vertex="1" parent="1">
