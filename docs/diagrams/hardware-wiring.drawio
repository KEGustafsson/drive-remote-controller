        <mxCell id="tx_esp" value="&lt;b style=&quot;font-size:14px&quot;&gt;SH-ESP32&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:12px&quot;&gt;TX unit&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;b style=&quot;font-size:11.5px&quot;&gt;Status LED — GPIO2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;solid = both units answering&lt;br&gt;warn blink = one unit missing&lt;br&gt;fast blink = neither · off = no link&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:10.5px&quot;&gt;switch commons -&amp;gt; onboard 3V3&lt;br&gt;GPIO reads: INPUT_PULLDOWN&lt;br&gt;8 contacts in total&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:11px&quot;&gt;VIN / GND terminal&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=8;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=14;fontColor=#1c1917;" vertex="1" parent="1">
