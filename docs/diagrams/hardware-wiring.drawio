          <mxGeometry x="650" y="236" width="200" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="rx_neutral" value="&lt;b&gt;Lever NEUTRAL Sensors&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11.5px&quot;&gt;GPIO36 port · GPIO39 stbd&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b45309&quot; style=&quot;font-size:9.5px&quot;&gt;&lt;b&gt;ACTIVE-LOW&lt;/b&gt; switch or hall sensor&lt;br&gt;external 10 kΩ pull-up REQUIRED&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
