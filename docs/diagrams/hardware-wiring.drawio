        <mxCell id="rx_stbd" value="&lt;b&gt;Local Stbd Switch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11.5px&quot;&gt;GPIO27 fwd · GPIO26 rev&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:9.5px&quot;&gt;mirrors TX wiring — unconditional override&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
