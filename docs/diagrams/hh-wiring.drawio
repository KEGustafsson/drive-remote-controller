<mxfile host="app.diagrams.net">
  <diagram id="hh-wiring" name="HH wiring">
    <mxGraphModel dx="1300" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#fcfcfb" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Hardware Wiring — HH, Heading Hold Controller (SH-ESP32)" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=19;fontStyle=1;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="240" y="16" width="700" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="A third, physically separate unit. It shares no wiring with TX or RX." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#8a877f;" vertex="1" parent="1">
          <mxGeometry x="290" y="44" width="600" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="imu" value="&lt;b&gt;BNO086 IMU&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;TX → GPIO23 (UART2 RX)&lt;br&gt;RST ← GPIO22 (reserved, not driven)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:9.5px&quot;&gt;UART-RVC · 115200 8N1 · 100 Hz&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="20" y="88" width="230" height="74" as="geometry"/>
        </mxCell>
        <mxCell id="engage" value="&lt;b&gt;ENGAGE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO35 · isolated opto in&lt;br&gt;2.5–18 V · input-only pin&lt;br&gt;sense UNVERIFIED — see SAFETY.md&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1a7f37&quot; style=&quot;font-size:9.5px&quot;&gt;unconditional local authority&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="20" y="186" width="230" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="deadman" value="&lt;b&gt;DEADMAN (not enabled yet)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO19 · internal pull-down&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:9.5px&quot;&gt;unwired reads not-held · fit 10 kΩ anyway&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="20" y="284" width="230" height="62" as="geometry"/>
        </mxCell>

        <mxCell id="a1" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="250" y="125" as="sourcePoint"/><mxPoint x="316" y="125" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#1a7f37;strokeWidth=2.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="250" y="223" as="sourcePoint"/><mxPoint x="316" y="223" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="a3" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#1a7f37;strokeWidth=2.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="250" y="315" as="sourcePoint"/><mxPoint x="316" y="315" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="esp" value="&lt;b style=&quot;font-size:14px&quot;&gt;SH-ESP32&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:12px&quot;&gt;HH unit&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;b style=&quot;font-size:11.5px&quot;&gt;Status LED — GPIO2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;solid = holding&lt;br&gt;slow blink = powered, idle&lt;br&gt;fast blink = FAULT&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:10.5px&quot;&gt;3V3 / GND pads power the IMU&lt;br&gt;— never from a GPIO&lt;br&gt;&lt;br&gt;GPIO16/17 (I²C) and GPIO4&lt;br&gt;(1-Wire) stay free&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:11px&quot;&gt;VIN / GND terminal&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=8;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=14;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="320" y="88" width="200" height="276" as="geometry"/>
        </mxCell>

        <mxCell id="outs" value="&lt;b&gt;Thruster Logic Outputs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:10.5px&quot;&gt;plain active-high 3.3 V logic&lt;/font&gt;&lt;hr size=&quot;1&quot; color=&quot;#0f766e33&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:10px&quot;&gt;&lt;font style=&quot;font-size:11.5px&quot;&gt;&lt;b&gt;ENABLE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO33 · master&lt;/font&gt;&lt;br&gt;&lt;b&gt;PORT&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO13&lt;/font&gt;&lt;br&gt;&lt;b&gt;STBD&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO27&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#0f766e33&quot;&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:10px&quot;&gt;never both directions at once;&lt;br&gt;directions inert while ENABLE is low&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=8;fillColor=#f2f8f7;strokeColor=#0f766e;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="590" y="122" width="210" height="188" as="geometry"/>
        </mxCell>
        <mxCell id="a4" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#0f766e;strokeWidth=2.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="520" y="216" as="sourcePoint"/><mxPoint x="586" y="216" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="iface" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;&lt;font color=&quot;#57534e&quot;&gt;Output Interface&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:11px&quot;&gt;&lt;font color=&quot;#b45309&quot;&gt;USER-PROVIDED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:10.5px&quot;&gt;isolation · level shift · drive&lt;br&gt;any external interlock&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:10px&quot;&gt;a hardware enable-heartbeat circuit&lt;br&gt;is strongly recommended here&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fcfcfb;strokeColor=#898781;strokeWidth=2;dashed=1;dashPattern=6 4;fontFamily=Segoe UI;fontSize=12.5;fontColor=#57534e;" vertex="1" parent="1">
          <mxGeometry x="850" y="122" width="230" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="a5" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="800" y="186" as="sourcePoint"/><mxPoint x="846" y="186" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="ctrlbox" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Thruster Control Box&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10px&quot;&gt;own ~1.75 s reversal interlock&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=12.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="880" y="288" width="170" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="a6" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="965" y="250" as="sourcePoint"/><mxPoint x="965" y="282" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="boatdc" value="&lt;b style=&quot;font-size:11.5px&quot;&gt;Boat DC&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10px&quot;&gt;8–32 V system&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6e7781;strokeWidth=2;fontFamily=Segoe UI;fontSize=11.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="320" y="394" width="95" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="term" value="&lt;b style=&quot;font-size:11px&quot;&gt;Terminal Block&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:9.5px&quot;&gt;fused, reverse-polarity&lt;br&gt;protected, TVS (on-board)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6e7781;strokeWidth=2;fontFamily=Segoe UI;fontSize=11;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="426" y="394" width="136" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="a7" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="415" y="421" as="sourcePoint"/><mxPoint x="426" y="421" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="a8" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="494" y="394" as="sourcePoint"/><mxPoint x="420" y="368" as="targetPoint"/>
            <Array as="points"><mxPoint x="494" y="381"/><mxPoint x="420" y="381"/></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="imunote" value="&lt;b style=&quot;font-size:12px&quot;&gt;IMU placement&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;Mount rigidly, axes roughly aligned to&lt;br&gt;the boat (X forward, Z vertical).&lt;br&gt;&lt;br&gt;Keep it away from the thruster motor&lt;br&gt;and heavy DC cabling — magnetic and&lt;br&gt;EMI interference.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=6;fillColor=#fcfcfb;strokeColor=#898781;strokeWidth=1.5;dashed=1;dashPattern=5 4;fontFamily=Segoe UI;fontSize=12;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="20" y="394" width="270" height="134" as="geometry"/>
        </mxCell>

        <mxCell id="scopenote" value="&lt;b style=&quot;font-size:12px&quot;&gt;Where firmware responsibility ends&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;The firmware drives three plain logic GPIOs and guarantees the logical invariants: never both directions, directions inert unless ENABLE is high, ENABLE low is the single fail-off. Everything downstream of those pins — isolation, drive current, connection to the thruster's remote — is the user's interface. A config flag flips polarity if it needs active-low.&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingTop=6;spacingRight=16;fillColor=#ffffff;strokeColor=#898781;strokeWidth=1.5;fontFamily=Segoe UI;fontSize=12;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="590" y="394" width="490" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="lg1s" value="" style="rounded=1;arcSize=20;html=1;fillColor=none;strokeColor=#1a7f37;strokeWidth=2.5;" vertex="1" parent="1">
          <mxGeometry x="20" y="551" width="20" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="lg1t" value="Hardwired local authority" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#57534e;" vertex="1" parent="1">
          <mxGeometry x="48" y="550" width="200" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg2s" value="" style="rounded=1;arcSize=20;html=1;fillColor=none;strokeColor=#0f766e;strokeWidth=2.5;" vertex="1" parent="1">
          <mxGeometry x="260" y="551" width="20" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="lg2t" value="Thruster output path" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#57534e;" vertex="1" parent="1">
          <mxGeometry x="288" y="550" width="180" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg3s" style="endArrow=none;html=1;strokeColor=#898781;strokeWidth=2;dashed=1;dashPattern=6 4;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="490" y="558" as="sourcePoint"/><mxPoint x="524" y="558" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="lg3t" value="Outside firmware scope" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#57534e;" vertex="1" parent="1">
          <mxGeometry x="532" y="550" width="200" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg4s" style="endArrow=classic;html=1;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="760" y="558" as="sourcePoint"/><mxPoint x="794" y="558" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="lg4t" value="Wired connection" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#57534e;" vertex="1" parent="1">
          <mxGeometry x="802" y="550" width="200" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="Commands from TX and the plugin reach this unit over Signal K — see system-overview.png. TX and RX wiring: hardware-wiring.png" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=11;fontColor=#8a877f;" vertex="1" parent="1">
          <mxGeometry x="20" y="592" width="900" height="16" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
