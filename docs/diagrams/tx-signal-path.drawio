<mxfile host="app.diagrams.net">
  <diagram id="tx-signal-path" name="TX signal path">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" background="#fcfcfb" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="TX — Handheld Controller Signal Path" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=19;fontStyle=1;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="210" y="18" width="600" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="All eight contacts sampled every 20 ms on the SensESP event loop — TX has no safety-critical local output, so it needs no RTOS task" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#8a877f;" vertex="1" parent="1">
          <mxGeometry x="60" y="44" width="900" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="in_port" value="&lt;b&gt;Port Shift Switch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO23 fwd · GPIO25 rev&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="30" y="76" width="212" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="in_stbd" value="&lt;b&gt;Stbd Shift Switch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO27 fwd · GPIO26 rev&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#2a78d6;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="30" y="144" width="212" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="in_thr" value="&lt;b&gt;Thruster Buttons&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO18 port · GPIO19 stbd&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f2f8f7;strokeColor=#0f766e;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="30" y="212" width="212" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="in_mode" value="&lt;b&gt;Thruster Mode&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO22 · latching MANUAL/HOLD&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f2f8f7;strokeColor=#0f766e;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="30" y="280" width="212" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="in_en" value="&lt;b&gt;Enable / Kill Switch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;GPIO21 · latching · arms both&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="30" y="348" width="212" height="56" as="geometry"/>
        </mxCell>

        <mxCell id="deb" value="&lt;b style=&quot;font-size:14px&quot;&gt;Debounce ×8&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;30 ms assert&lt;br&gt;30 ms release&lt;br&gt;&lt;br&gt;contact-bounce&lt;br&gt;settle only&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size:11px&quot;&gt;— not a dwell —&lt;/b&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="292" y="76" width="150" height="328" as="geometry"/>
        </mxCell>

        <mxCell id="d1" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="242" y="104" as="sourcePoint"/><mxPoint x="288" y="104" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="d2" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="242" y="172" as="sourcePoint"/><mxPoint x="288" y="172" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="d3" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="242" y="240" as="sourcePoint"/><mxPoint x="288" y="240" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="d4" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="242" y="308" as="sourcePoint"/><mxPoint x="288" y="308" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="d5" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#b45309;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="242" y="376" as="sourcePoint"/><mxPoint x="288" y="376" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="fromswitch" value="&lt;b&gt;FromSwitch() ×2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;stateless — fwd / neutral / rev&lt;br&gt;both contacts active → NEUTRAL&lt;br&gt;release → NEUTRAL (no latch)&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="492" y="76" width="230" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="modemap" value="&lt;b&gt;Mode decides the meaning&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:10.5px&quot;&gt;MANUAL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;button = direction; release = off&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:10.5px&quot;&gt;HOLD&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;tap = 1° trim, hold = 10° repeat&lt;br&gt;relative trim offset, 0 = none&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f2f8f7;strokeColor=#0f766e;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="492" y="192" width="230" height="128" as="geometry"/>
        </mxCell>

        <mxCell id="m1" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="442" y="124" as="sourcePoint"/><mxPoint x="488" y="124" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1t" value="4" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=9.5;fontColor=#8a877f;" vertex="1" parent="1">
          <mxGeometry x="450" y="104" width="30" height="14" as="geometry"/>
        </mxCell>
        <mxCell id="m2" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="442" y="256" as="sourcePoint"/><mxPoint x="488" y="256" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m2t" value="3" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=9.5;fontColor=#8a877f;" vertex="1" parent="1">
          <mxGeometry x="450" y="236" width="30" height="14" as="geometry"/>
        </mxCell>

        <mxCell id="pub" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Signal K Publish&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;on change + every 250 ms&lt;/font&gt;&lt;br&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:6px&quot;&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;tx.port.command&lt;br&gt;tx.stbd.command&lt;br&gt;&lt;font color=&quot;#0f766e&quot;&gt;tx.thruster.command&lt;br&gt;tx.thruster.mode&lt;br&gt;tx.thruster.trimDeg&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#b45309&quot;&gt;tx.enabled&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;font color=&quot;#8a877f&quot; style=&quot;font-size:10px&quot;&gt;the periodic refresh keeps each&lt;br&gt;unit's 1 s liveness watchdog fed&lt;br&gt;during a long steady press&lt;/font&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=6;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=13.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="772" y="76" width="218" height="244" as="geometry"/>
        </mxCell>

        <mxCell id="p1" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="722" y="124" as="sourcePoint"/><mxPoint x="768" y="124" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="p2" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#0f766e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="722" y="256" as="sourcePoint"/><mxPoint x="768" y="200" as="targetPoint"/>
            <Array as="points"><mxPoint x="745" y="256"/><mxPoint x="745" y="200"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#b45309;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="442" y="376" as="sourcePoint"/><mxPoint x="768" y="245" as="targetPoint"/>
            <Array as="points"><mxPoint x="745" y="376"/><mxPoint x="745" y="245"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p3t" value="enabled (bool) — bypasses both mappings, arms both machines" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=10.5;fontColor=#b45309;labelBackgroundColor=#fcfcfb;" vertex="1" parent="1">
          <mxGeometry x="450" y="354" width="330" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="wifi" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;WiFi&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:11px&quot;&gt;→ Signal K Server&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6e7781;strokeWidth=2;fontFamily=Segoe UI;fontSize=12.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="772" y="352" width="218" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="p4" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="881" y="320" as="sourcePoint"/><mxPoint x="881" y="348" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="momnote" value="Every direction control is momentary: releasing returns to the safe&lt;br&gt;value automatically. Nothing latches a gear or a thrust direction." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#fcfcfb;strokeColor=#898781;strokeWidth=1.5;dashed=1;dashPattern=5 4;fontFamily=Segoe UI;fontSize=11.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="30" y="424" width="440" height="52" as="geometry"/>
        </mxCell>

        <mxCell id="sep" style="endArrow=none;html=1;strokeColor=#e1e0d9;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="30" y="512" as="sourcePoint"/><mxPoint x="990" y="512" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="septext" value="Independent of the command path above — the status LED is honest about whether a press can reach a LIVE unit, re-evaluated every 50 ms" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#8a877f;" vertex="1" parent="1">
          <mxGeometry x="30" y="524" width="960" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="sock" value="&lt;b style=&quot;font-size:12px&quot;&gt;TX socket: is_connected()&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;SensESP WiFi / SK client&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6e7781;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="30" y="556" width="264" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rxlive" value="&lt;b style=&quot;font-size:12px&quot;&gt;RX live? rx.linkUp arriving&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;LinkWatchdog · 1.5 s&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6e7781;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="30" y="618" width="264" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="hhlive" value="&lt;b style=&quot;font-size:12px&quot;&gt;HH live? hh.linkUp arriving&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;LinkWatchdog · 1.5 s&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6e7781;strokeWidth=2;fontFamily=Segoe UI;fontSize=12;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="30" y="680" width="264" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="arrnote" value="liveness is judged on ARRIVAL, never on a published value" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=10.5;fontColor=#8a877f;" vertex="1" parent="1">
          <mxGeometry x="30" y="736" width="264" height="16" as="geometry"/>
        </mxCell>

        <mxCell id="eval" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;EvaluateLinkIndicator&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#57534e&quot; style=&quot;font-size:10.5px&quot;&gt;link_indicator.h (pure)&lt;br&gt;off / fault / ready-to-arm /&lt;br&gt;warn / ready&lt;br&gt;socket-down dominates&lt;/font&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#24292f;strokeWidth=2;fontFamily=Segoe UI;fontSize=12.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="360" y="596" width="220" height="94" as="geometry"/>
        </mxCell>

        <mxCell id="ledbox" value="&lt;b style=&quot;font-size:12.5px&quot;&gt;Status LED · GPIO2&lt;/b&gt;&lt;hr size=&quot;1&quot; color=&quot;#e1e0d9&quot;&gt;&lt;div style=&quot;text-align:left;padding-left:8px&quot;&gt;&lt;font style=&quot;font-size:10.5px&quot;&gt;&lt;b&gt;solid&lt;/b&gt; — armed, both units answering&lt;br&gt;&lt;b&gt;warn blink&lt;/b&gt; (~2 Hz) — armed, one answering&lt;br&gt;&lt;b&gt;ready blink&lt;/b&gt; (~1 Hz) — disarmed, a unit is reachable&lt;br&gt;&lt;b&gt;fault blink&lt;/b&gt; (~5 Hz) — neither answering&lt;br&gt;&lt;b&gt;off&lt;/b&gt; — TX's own socket is down&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;verticalAlign=top;spacingTop=6;fillColor=#ffffff;strokeColor=#1a7f37;strokeWidth=2.5;fontFamily=Segoe UI;fontSize=12.5;fontColor=#1c1917;" vertex="1" parent="1">
          <mxGeometry x="650" y="570" width="340" height="146" as="geometry"/>
        </mxCell>

        <mxCell id="l1" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="294" y="581" as="sourcePoint"/><mxPoint x="356" y="612" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="l2" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="294" y="643" as="sourcePoint"/><mxPoint x="356" y="643" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="l3" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="294" y="705" as="sourcePoint"/><mxPoint x="356" y="674" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="l4" style="edgeStyle=none;html=1;endArrow=classic;strokeColor=#52514e;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="580" y="643" as="sourcePoint"/><mxPoint x="646" y="643" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="fbnote" value="Feedback only — the LED never gates what TX publishes" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=10.5;fontColor=#8a877f;" vertex="1" parent="1">
          <mxGeometry x="650" y="726" width="340" height="16" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
